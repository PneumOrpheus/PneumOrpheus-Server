APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
APP_LOG_LEVEL=INFO

# Optional: enforce bearer auth from pneumorpheus-app
INFERENCE_API_KEY=

# Default model selection metadata
DEFAULT_MODEL_NAME=pneumorpheus-primary
DEFAULT_MODEL_VERSION=v1

# local|azure_blob
MODEL_SOURCE=local
MODEL_LOCAL_DIR=./models
MODEL_CACHE_DIR=./model-cache

# Used when MODEL_SOURCE=azure_blob (typically with managed identity)
AZURE_STORAGE_ACCOUNT_URL=
AZURE_BLOB_CONTAINER=
AZURE_BLOB_PREFIX=models
